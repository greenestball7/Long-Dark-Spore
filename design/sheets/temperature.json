    {"id": "wind_light_snow",    "kind": "wind",    "celsius": -4,  "applies_when": "weather_light_snow",   "stages": ["cell", "creature"]},
    {"id": "wind_blizzard",      "kind": "wind",    "celsius": -18, "applies_when": "weather_blizzard",     "stages": ["cell", "creature"]},
    {"id": "exertion",           "kind": "bonus",   "celsius": 6,   "applies_when": "player_moving_fast",   "stages": ["cell", "creature"]},
    {"id": "huddle_herd",        "kind": "bonus",   "celsius": 8,   "applies_when": "creature_near_herd",   "stages": ["creature"]},
    {"id": "nest_shelter",       "kind": "bonus",   "celsius": 22,  "applies_when": "creature_near_nest",   "stages": ["creature"]},
